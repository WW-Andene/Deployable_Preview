    "@ngrok/ngrok": "^1.4.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5",
    "axe-core": "^4.10.2",
    "tesseract.js": "^5.1.1",
    "lighthouse": "^12.2.1",
    "css-tree": "^3.0.1",
    "colorthief": "^2.4.0",
    "get-image-colors": "^4.0.1",
    "ssim.js": "^3.5.0",
    "looks-same": "^9.0.1",
    "cheerio": "^1.0.0",
    "css-select": "^5.1.0",
    "specificity": "^1.0.0",
    "web-vitals": "^4.2.4",
