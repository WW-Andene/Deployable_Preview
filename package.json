{
  "name": "deployview",
  "version": "1.1.0",
  "description": "Build, serve, and preview your app from GitHub — replaces Vercel/Netlify/Screenfly",
  "main": "server/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WW-Andene/Deployable_Preview.git"
  },
  "homepage": "https://github.com/WW-Andene/Deployable_Preview",
  "keywords": [
    "deploy",
    "preview",
    "github",
    "ci",
    "cd",
    "build",
    "vercel",
    "netlify",
    "mcp",
    "claude",
    "ai"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:http": "node server/index.js --no-mcp",
    "mcp": "node server/mcp.js",
    "start:mcp": "node server/index.js",
    "test": "node --test test/*.test.js",
    "audit:json": "npm audit --json || true",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "localtunnel": "^2.0.2",
    "@babel/code-frame": "^7.26.0"
  },
