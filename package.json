{
  "name": "deployview",
  "version": "1.1.0",
  "description": "Build, serve, and preview your app from GitHub — replaces Vercel/Netlify/Screenfly",
  "main": "server/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WW-Andene/Deployable_Preview.git"
  },
  "homepage": "https://github.com/WW-Andene/Deployable_Preview",
  "keywords": [
    "deploy",
    "preview",
    "github",
    "ci",
    "cd",
    "build",
    "vercel",
    "netlify",
    "mcp",
    "claude",
    "ai"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:http": "node server/index.js --no-mcp",
    "mcp": "node server/mcp.js",
    "start:mcp": "node server/index.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "localtunnel": "^2.0.2"
  },
  "optionalDependencies": {
    "playwright": "^1.40.0",
    "puppeteer-core": "^24.0.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5",
    "axe-core": "^4.10.2",
    "tesseract.js": "^5.1.1",
    "lighthouse": "^12.2.1",
    "css-tree": "^3.0.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
