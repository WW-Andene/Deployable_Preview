# DeployView environment variables — copy to .env and edit
# Loaded automatically by server/index.js if dotenv is installed,
# or via the built-in fallback parser otherwise.

# ── HTTP server ────────────────────────────────────────────────────────
PORT=3000
# NODE_ENV=production
# LOG_REQUESTS=true

# ── HTTPS (optional; required if you want claude.ai to talk to you
# without going through a tunnel) ──────────────────────────────────────
# HTTPS_CERT=cert.pem
# HTTPS_KEY=key.pem
# HTTPS_PORT=3443

# ── Tunnel providers (cloudflared has no auth; ngrok needs token) ─────
# NGROK_AUTHTOKEN=

# ── Browser automation (Playwright local OR Browserless remote) ───────
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# BROWSERLESS_API_KEY=
# BROWSER_WS_ENDPOINT=

# ── Resource limits (sane defaults — only override if needed) ─────────
# MAX_CONCURRENT_BUILDS=4
# DV_MAX_THUMBS=40
# DV_SESSION_TTL_MS=300000
# DV_MAX_SESSIONS=100
# DV_MAX_LOG_BYTES=5242880          # 5 MiB per log file before rotation

# ── Optional 3rd-party API keys (also settable in Settings UI) ────────
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# ── Webhook signing — REQUIRED if you expose /api/webhook to the
# internet. Server fail-secures with 403 if unset. ────────────────────
# WEBHOOK_SECRET=
